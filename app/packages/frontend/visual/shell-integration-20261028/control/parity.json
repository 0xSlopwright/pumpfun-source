{
  "scope": "Bounded shell comparison: retained SSR with explicitly emulated display states vs. local frontend at identical viewports.",
  "method": {
    "reference": "Hash-checked captured HTML with every <script> removed and captured JS unserved. Only the local, nonce-bound segment-placement helper runs. CSP blocks remote assets/connections and captured active content. The signed-out display attribute is applied explicitly; overlay-closed-emulation also applies the accepted-display attribute. These are controlled display branches, not a claim about the captured visitor session/cookies.",
    "segmentPlacement": "Babel parses literal top-level $RS/$RC calls and $RR stylesheet-gated boundaries, ignoring strings and function bodies. The local renderer awaits the recorded captured stylesheets, then moves only the named retained DOM segments after DOMContentLoaded.",
    "local": "http://127.0.0.1:3017",
    "declaredLocalSourceDirectory": "/workspace/pump-app-shell-control/app/packages/frontend",
    "masksBothRenders": [
      "*,*::before,*::after{animation:none!important;transition:none!important;caret-color:transparent!important}",
      ".pump-page-container>*{display:none!important}",
      ".pump-page-container{min-height:600px!important}",
      "#main-content>.page-container>*{display:none!important}",
      "#main-content>.page-container{min-height:600px!important}",
      "[data-clickwrap-overlay]>div>:first-child{visibility:hidden!important}"
    ],
    "excludedFromReferenceOnly": [
      "#appsflyer-smart-banner-host+.max-md\\:hidden{display:none!important}",
      "li:has(>[data-testid=try-app-button-sidebar]){display:none!important}"
    ],
    "channelTolerance": 24,
    "regionCellPixels": 16
  },
  "limits": [
    "Measures the shell around a masked page body; page bodies and live data are not compared.",
    "The reference is server-rendered HTML without client hydration, i.e. the first-paint state.",
    "Pixel equality is a visual check, not DOM, behavior or accessibility equivalence.",
    "The local placement helper waits for DOMContentLoaded so every named retained segment has been parsed; every reference capture requires a visible shell.",
    "Captured browser consent/auth state is unknown. Overlay-closed emulation is separate from the unclosed SSR overlay case; current local first-visit consent remains unimplemented."
  ],
