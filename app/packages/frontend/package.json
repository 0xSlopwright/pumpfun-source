  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
