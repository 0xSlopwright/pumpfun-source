"use client";

// Copied only by with-auth-fixture.mjs into an isolated test checkout, never shipped as a route.
import { useState } from "react";
import { AuthControl } from "../auth/auth-control";
import type { AuthPresentation, AuthPresentationAdapter } from "../auth/auth-model";

const scenarios = ["ready", "slow", "failure", "retry", "timeout", "stale", "invalid", "empty", "many"] as const;
type Scenario = typeof scenarios[number];
const presentation: AuthPresentation = {
  source: "synthetic-test", session: "anonymous", recentWallet: "Test recent",
  wallets: [
    { name: "Phantom", readiness: "loadable" },
    { name: "Coinbase Wallet", readiness: "loadable" },
    { name: "Test installed", readiness: "installed" },
    { name: "Test recent", readiness: "loadable" },
  ],
};

function makeAdapter(scenario: Scenario): AuthPresentationAdapter {
  let attempt = 0;
  return { async read(signal) {
    attempt++;
    if (scenario === "failure" || (scenario === "retry" && attempt === 1)) throw new Error("synthetic read failure");
    if (scenario === "invalid") return { source: "live", session: "authenticated" };
    if (scenario === "empty") return { ...presentation, recentWallet: null, wallets: [] };
    if (scenario === "many") return { ...presentation, recentWallet: null,
      wallets: Array.from({ length: 40 }, (_, index) => ({ name: `Test wallet ${index + 1}`, readiness: "installed" })) };
    if (scenario === "timeout") return new Promise((_, reject) => {
      signal.addEventListener("abort", () => reject(new DOMException("Cancelled", "AbortError")), { once: true });
    });
    if (scenario === "slow") return new Promise((resolve) => setTimeout(() => resolve(presentation), 1_000));
    if (scenario === "stale") {
      const initial = attempt === 1;
      // Intentionally ignores cancellation to exercise the controller's sequence boundary.
      return new Promise((resolve) => setTimeout(() => resolve({ ...presentation,
        session: initial ? "anonymous" : "expired" }), initial ? 2_000 : 50));
    }
    return presentation;
  } };
}

function FixtureControl({ scenario }: { scenario: Scenario }) {
  const [adapter] = useState(() => makeAdapter(scenario));
  return <div data-testid="auth-fixture-control"><AuthControl adapter={adapter} syntheticTest /></div>;
}

export default function AuthTestPage() {
  const [scenario, setScenario] = useState<Scenario>("ready");
  return <section>
    <h1>Synthetic authentication presentation tests</h1>
    <p>Test-only UI. There are no accounts, credentials, connected wallets or provider requests.</p>
    <label>Test scenario <select value={scenario} onChange={(event) => setScenario(event.target.value as Scenario)}>
      {scenarios.map((item) => <option key={item}>{item}</option>)}
    </select></label>
    <FixtureControl key={scenario} scenario={scenario} />
    <a href="/explore">Leave test page</a>
  </section>;
}
