  "localPolicy": [
    "Opt-in discovery",
    "Only connect/disconnect/change ports",
    "No silent or automatic reconnect",
    "No accounts read until explicit connect resolves",
    "No signing or server session",
    "No persistence; close/route/unmount forgets",
    "Only protocol-v1 Solana metadata; first Solana account must be canonical 32-byte base58",
    "No remote wallet icons or legacy navigator.wallets migration"
  ],
  "limits": [
    "Protocol-compatible extension fixture is synthetic; no live wallet or authenticated upstream oracle",
    "No claim of original wallet selection, provider tenant configuration, consent text or visual parity",
