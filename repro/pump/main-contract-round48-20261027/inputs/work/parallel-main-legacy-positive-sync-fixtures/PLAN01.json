  "execution_requirements": [
    "Keep captured base mint, base vault and base user account bytes/owners/authorities and total supply unchanged before the trade. Keep base balances summing to the captured 10^15 supply.",
    "Use normal recorded test USER signing. Set Global.whitelist_pda to USER in each case. Positive and mode-disabled controls differ in the curve mode flag and corresponding validated fee-recipient choice.",
    "Use only the documented curve reserves/flags and 4 SOL curve backing plus the existing normal 1000 SOL user funding. Do not mutate owner, executable flag, mint authority or token supply.",
    "Use original legacy buy, buy_exact_sol_in and sell account layouts. For buy variants set track_volume=false and partial_fill=false. Retain existing normal remaining accounts for bonding_curve_v2 and buyback recipient; preserve their PDA and owner checks.",
    "Record full non-target account prestate, Clock, signed transaction bytes and signature verification for original/candidate. Run only when the selected candidate contains the independently reviewed legacy reload source.",
    "Require actual original success and exact paired error, state, CPI, event, return-data and ordered-log agreement. Verify captured post-CPI base balances and independent sync formula; never force expected outputs.",
    "Deduplicate transaction + complete prestate/Clock against 18111 retained corpus pairs, eight new SellV3 fixtures, and any admitted V2 positive fixtures before claiming new case count."
  ],
  "formula": {
    "buy_v2": "q=floor(amount*vqr/(vtr-amount))+1",
    "buy_exact_quote_in_v2_whitelist": "q=input; amount=floor(vtr*(q-1)/(vqr+q-1)); input covers zero protocol/creator fees",
    "sell_v2": "q=floor(amount*vqr/(vtr+amount))",
    "post_curve": "Buy subtracts amount from both token reserves and adds q to both quote reserves; sell reverses those signs.",
    "sync": "D=2*token_total_supply-post_base_vault-post_base_user; vqr=floor((D+post_vtr)*post_rqr/D), then native/token cap; all proposed values remain below cap."
  },
  "limits": [
    "No VM, transaction construction, signing or execution performed by this plan.",
    "Legacy entry points use native quote only; token-quote scenarios belong to V2/V3.",
    "The retained legacy regression suites have no decidable payer==whitelist case; this plan adds targeted positive coverage after approval."
  ]
}
