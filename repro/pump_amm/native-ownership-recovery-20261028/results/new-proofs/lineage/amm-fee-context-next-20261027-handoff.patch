+#[inline(never)]
+pub fn apply_hop_fees(context: HopFeeContext, amount: u64) -> Result<crate::curve::fees::AppliedFees> {
+    let fees = crate::curve::fees::select_and_apply_v2(
+        context.pool, context.global_config, &context.accounts.fee_config,
+        *context.fee_config_len, *context.base_supply, *context.base_reserve,
+        *context.quote_reserve, amount,
+    )?;
+    let (creator_fee_bps, creator_fee) = if context.gates.creator {
+        (fees.creator_fee_bps, fees.creator_fee)
+    } else {
+        (0, 0)
+    };
+    let (lp_fee_bps, lp_fee) = if context.gates.lp {
+        (fees.lp_fee_bps, fees.lp_fee)
+    } else {
+        (0, 0)
+    };
+    let (protocol_fee_bps, protocol_fee) = if context.gates.protocol {
+        (fees.protocol_fee_bps, fees.protocol_fee)
+    } else {
+        (0, 0)
+    };
+    Ok(crate::curve::fees::AppliedFees {
+        lp_fee_bps, protocol_fee_bps, creator_fee_bps,
+        lp_fee, protocol_fee, creator_fee,
+    })
+}
